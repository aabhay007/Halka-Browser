{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halka Browser",
  "version": "0.1.0",
  "identifier": "com.halka.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Halka Browser",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
